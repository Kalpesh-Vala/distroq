# Placeholders only. Copy to .env, fill in real values, and never commit the result -
# .gitignore and .dockerignore both exclude .env.
#
# Anything marked REQUIRED has no default anywhere in the application. Leaving it unset fails
# startup with the property named, which is deliberate: a deployment that comes up with a
# placeholder password is worse than one that does not come up.

# ---------------------------------------------------------------- profile
SPRING_PROFILES_ACTIVE=production

# ---------------------------------------------------------------- PostgreSQL (REQUIRED)
DISTROQ_DB_URL=jdbc:postgresql://postgres:5432/distroq
DISTROQ_DB_USER=distroq
# REQUIRED. Generate with: openssl rand -base64 24
DISTROQ_DB_PASSWORD=CHANGE_ME
DISTROQ_DB_POOL_MAX=10
DISTROQ_DB_POOL_MIN=2
DISTROQ_DB_CONNECTION_TIMEOUT_MS=5000

# The compose file initialises the database container from these. They must agree with the two
# above; they are separate variables because one pair configures a client and the other a server.
POSTGRES_DB=distroq
POSTGRES_USER=distroq
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- Redis (REQUIRED)
DISTROQ_REDIS_HOST=redis
DISTROQ_REDIS_PORT=6379
# Leave empty only on a network where nothing else can reach the port.
DISTROQ_REDIS_PASSWORD=
DISTROQ_REDIS_SSL=false
DISTROQ_REDIS_TIMEOUT_MS=5000
DISTROQ_REDIS_POOL_MAX=16

# ---------------------------------------------------------------- administrative access (REQUIRED)
# Guards /api/admin/** and /api/idempotency/**. Startup fails under the production profile if this
# is unset. Generate with: openssl rand -hex 32
# Rotation and revocation are documented in SECURITY.md; both are a restart with a new value.
DISTROQ_ADMIN_TOKEN=CHANGE_ME
DISTROQ_ADMIN_ENABLED=true
DISTROQ_ADMIN_DEFAULT_ACTOR=admin

# ---------------------------------------------------------------- workers
DISTROQ_WORKER_CONCURRENCY=4
DISTROQ_WORKER_LEASE_MS=30000
DISTROQ_WORKER_HEARTBEAT_MS=5000
# Must exceed the longest expected job duration, or a healthy slow worker looks abandoned to the
# recovery sweep and its job is executed a second time.
DISTROQ_CLAIM_MIN_IDLE_MS=60000

# ---------------------------------------------------------------- reliability
DISTROQ_OUTBOX_RELAY_ENABLED=true
DISTROQ_RECONCILIATION_ENABLED=true
# Repairs are opt-in. See NOTES.md for what auto-repair will and will not do on its own.
DISTROQ_RECONCILIATION_AUTO_REPAIR=false

# ---------------------------------------------------------------- shutdown budgets
DISTROQ_SHUTDOWN_WORKER_TIMEOUT_MS=30000
DISTROQ_SHUTDOWN_RELAY_TIMEOUT_MS=10000
DISTROQ_SHUTDOWN_SCHEDULER_TIMEOUT_MS=10000

# ---------------------------------------------------------------- observability
DISTROQ_LOG_LEVEL=INFO
DISTROQ_LOG_LEVEL_ROOT=INFO
# Optional. Defaults to <hostname>-<random>, which is what makes two instances on one host
# distinguishable in the logs.
# DISTROQ_INSTANCE_ID=

# ---------------------------------------------------------------- HTTP
DISTROQ_HTTP_MAX_THREADS=200

# ---------------------------------------------------------------- analytics (v0.9, read-only)
DISTROQ_ANALYTICS_DB_USER=distroq_readonly
DISTROQ_ANALYTICS_DB_PASSWORD=CHANGE_ME
DISTROQ_ANALYTICS_SPARK_MASTER=local[*]
DISTROQ_ANALYTICS_LOG_LEVEL=WARN
